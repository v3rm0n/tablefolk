{
  "name": "tablefolk",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @p2pcards/web",
    "build": "npm run build --workspaces --if-present",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser": "playwright test",
    "typecheck:browser-tests": "tsc --noEmit -p tsconfig.browser-tests.json",
    "typecheck": "npm run typecheck --workspaces --if-present && npm run typecheck:browser-tests",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.1.1",
    "fake-indexeddb": "^6.2.5",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "ws": "^8.21.3"
  }
}
